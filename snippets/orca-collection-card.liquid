{% doc %}
  Collection card with a gradient stage, product on a pedestal, title, and count.

  @param {object} [card_collection] - Collection to render
  @param {number} [index] - Card index for staggered decoration

  @example
  {% render 'orca-collection-card', card_collection: collection, index: forloop.index %}
{% enddoc %}

{%- liquid
  assign media = card_collection.featured_image
  if media == blank and card_collection.products.first.featured_image != blank
    assign media = card_collection.products.first.featured_image
  endif
  assign count = card_collection.all_products_count | default: 0
  if card_collection.title != blank
    assign title = card_collection.title
  else
    assign title = 'onboarding.collection_title' | t
  endif
-%}

{%- if card_collection != blank and card_collection.url != blank -%}
  <a href="{{ card_collection.url }}" class="orca-cat-card">
{%- else -%}
  <div class="orca-cat-card orca-cat-card--placeholder" role="link" aria-disabled="true">
{%- endif -%}
  <span class="orca-cat-card__glow" aria-hidden="true"></span>
  <span class="orca-cat-card__rings" aria-hidden="true"></span>
  <span class="orca-cat-card__stage">
    {%- if media != blank -%}
      <span class="orca-cat-card__product">
        {{
          media
          | image_url: width: 800
          | image_tag:
            class: 'orca-cat-card__image',
            widths: '400, 600, 800',
            sizes: '(min-width: 990px) 28vw, (min-width: 750px) 44vw, 86vw',
            loading: 'lazy',
            alt: ''
        }}
      </span>
    {%- else -%}
      <span class="orca-cat-card__product orca-cat-card__product--empty" aria-hidden="true"></span>
    {%- endif -%}
    <span class="orca-cat-card__pedestal" aria-hidden="true"></span>
  </span>
  <span class="orca-cat-card__footer">
    <span class="orca-cat-card__copy">
      <span class="orca-cat-card__title">{{ title | escape }}</span>
      {%- if card_collection != blank -%}
        <span class="orca-cat-card__count">{{ 'sections.collection_list.product_count' | t: count: count }}</span>
      {%- endif -%}
    </span>
    <span class="orca-cat-card__go" aria-hidden="true">
      {% render 'orca-icon', icon: 'arrow-right' %}
    </span>
  </span>
{%- if card_collection != blank and card_collection.url != blank -%}
  </a>
{%- else -%}
  </div>
{%- endif -%}
